    "menus": {
      "view/item/context": [
        {
          "command": "dhimantai.openCourse",
          "when": "view == dhimantai.practice && viewItem =~ /^dhimantaiCourse/",
          "group": "inline"
        },
        {
          "command": "dhimantai.openCourse",
          "when": "view == dhimantai.practice && viewItem =~ /^dhimantaiCourse/",
          "group": "navigation"
        },
        {
          "command": "dhimantai.openCourseColab",
          "when": "view == dhimantai.practice && viewItem == dhimantaiCourseColab",
          "group": "inline"
        },
        {
          "command": "dhimantai.openCourseColab",
          "when": "view == dhimantai.practice && viewItem == dhimantaiCourseColab",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "dhimantai.openDoubtSolver",
          "when": "view == dhimantai.practice",
          "group": "learning@1"
        },
        {
          "command": "dhimantai.practiceHistory",
          "when": "view == dhimantai.practice",
          "group": "navigation@3"
        },
        {
          "command": "dhimantai.courseCatalog",
          "when": "view == dhimantai.practice",
          "group": "navigation@1"
        },
        {
          "command": "dhimantai.openLearningRoom",
          "when": "view == dhimantai.practice",
          "group": "navigation@2"
        },
        {
          "command": "dhimantai.refreshPractice",
          "when": "view == dhimantai.practice",
          "group": "navigation"
        }
      ],
      "editor/title": [],
      "editor/context": [
        {
          "command": "dhimantai.openProjectCoach",
          "when": "!dhimantai.projectOpen && resourceScheme == file && isWorkspaceTrusted",
          "group": "dhimantai@1"
        },
        {
          "command": "dhimantai.discussProjectSelection",
          "when": "dhimantai.projectOpen && dhimantai.legacyCoachOpen && editorHasSelection && resourceScheme == file",
          "group": "dhimantai@1"
        },
        {
          "command": "dhimantai.suggestNextLine",
          "when": "notebookCellType == code",
          "group": "dhimantai@1"
        }
      ],
