{
  "name": "dhimantai-learning",
  "displayName": "dhimantAI Learning",
  "description": "Learn in VS Code with Course Catalog, Instructor, Doubt Solver, and coding practice. Write, debug, and test here; run projects and tests in the course container.",
  "version": "0.39.72",
  "publisher": "optficial",
  "enabledApiProposals": [
    "browser"
  ],
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "workspaceContains:.dhimantai.json",
    "workspaceContains:.dhimantai-project.json",
    "onNotebook:jupyter-notebook",
    "onTerminalProfile:dhimantai.courseShell"
  ],
  "contributes": {
    "terminal": {
      "profiles": [
        {
          "id": "dhimantai.courseShell",
          "title": "dhimantAI Course Container",
          "icon": "terminal"
        }
      ]
    },
    "configurationDefaults": {
      "chat.disableAIFeatures": true,
      "editor.tabCompletion": "on",
      "editor.minimap.enabled": false,
      "js/ts.tsserver.useSyntaxServer": "never",
      "typescript.tsserver.useSyntaxServer": "never",
      "terminal.integrated.defaultProfile.windows": "dhimantAI Course Container",
      "terminal.integrated.defaultProfile.osx": "dhimantAI Course Container",
      "terminal.integrated.defaultProfile.linux": "dhimantAI Course Container"
    },
