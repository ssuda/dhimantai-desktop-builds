        {
          "command": "dhimantai.skilling.discuss",
          "when": "false"
        },
        {
          "command": "dhimantai.skilling.course",
          "when": "false"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "dhimantai.practice.grade",
          "when": "notebookType == jupyter-notebook && dhimantai.practiceNotebook",
          "group": "navigation@1"
        },
        {
          "command": "dhimantai.useColabKernel",
          "when": "notebookType == jupyter-notebook && !dhimantai.practiceNotebook",
          "group": "navigation"
        },
        {
          "command": "dhimantai.openCopyInCourse",
          "when": "notebookType == jupyter-notebook && !dhimantai.practiceNotebook",
          "group": "navigation"
        },
        {
          "command": "dhimantai.askCoach",
          "when": "notebookType == jupyter-notebook && !dhimantai.practiceNotebook",
          "group": "navigation"
        }
      ],
      "dhimantai.skillingMenu": [
        {
          "command": "dhimantai.skilling.resume",
          "group": "1_home@1",
          "when": "dhimantai.canResume && !dhimantai.skilling.course && !dhimantai.skilling.project"
        },
        {
          "command": "dhimantai.skilling.ask",
          "group": "2_work@1",
          "when": "dhimantai.skilling.ask"
        },
        {
          "command": "dhimantai.skilling.project",
          "group": "2_work@1",
          "when": "dhimantai.skilling.project"
        },
        {
          "command": "dhimantai.skilling.discuss",
          "group": "2_work@2",
          "when": "dhimantai.skilling.discuss && dhimantai.skilling.hasSelection"
        },
        {
          "command": "dhimantai.skilling.check",
          "group": "2_work@3",
          "when": "dhimantai.skilling.check"
        },
        {
          "command": "dhimantai.skilling.grade",
          "group": "2_work@4",
          "when": "dhimantai.skilling.grade"
        },
        {
          "command": "dhimantai.skilling.feedback",
          "group": "2_work@4",
          "when": "dhimantai.skilling.feedback"
        },
        {
          "command": "dhimantai.skilling.course",
          "group": "3_course@1",
          "when": "dhimantai.skilling.course"
        },
        {
          "command": "dhimantai.courseCatalog",
          "group": "4_browse@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dhimantai.acceptNextLine",
        "key": "tab",
        "when": "dhimantai.nextLineVisible && editorTextFocus && !editorTabMovesFocus"
      },
      {
        "command": "dhimantai.dismissNextLine",
        "key": "escape",
        "when": "dhimantai.nextLineVisible && editorTextFocus"
      },
      {
        "command": "dhimantai.askCoach",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "notebookType == jupyter-notebook"
      }
    ],
    "configuration": {
      "title": "dhimantAI",
      "properties": {
        "dhimantai.autoUpdate": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Download and verify updates in the background. Learning updates install quietly and activate on your next normal restart. In dhimantAI desktop, native installers download automatically; open the installer from App Updates when you are ready. Checks run at startup and every six hours. Enabled by default in dhimantAI desktop; switch this off to download manually. Separate from Marketplace updates."
        },
        "dhimantai.environment": {
          "type": "string",
          "enum": [
            "production",
            "staging",
            "development",
            "local"
          ],
          "default": "production",
          "description": "Which dhimantAI service to use. Exercises and progress are shared with the app for the same environment."
        },
        "dhimantai.exercisesFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Parent folder for local course files and exercises. Defaults to `~/dhimantAI`."
        },
        "dhimantai.practiceEditor": {
          "type": "string",
          "enum": [
            "notebook",
            "panel"
          ],
          "enumDescriptions": [
            "A real Jupyter notebook. Official language extensions give completion and errors; help, sample tests and Instructor replies stay in the notebook.",
            "Shared learning notebook with Instructor conversation, code, attachments and audio in one place."
          ],
          "default": "panel",
          "scope": "window",
          "markdownDescription": "Where Practice tasks open."
        },
        "dhimantai.aiAssistance": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Enable AI assistance during practice. Off disables chat, hints, code suggestions, automatic nudges and debugger coaching. Workspace assessment policy always takes precedence."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "dhimantai",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "build"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dhimantai-learning",
          "title": "Learning",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dhimantai-coach",
          "title": "Instructor",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dhimantai-coach": [
        {
          "id": "dhimantai.coachView",
          "name": "Project Instructor",
          "type": "webview",
          "when": "dhimantai.nativeCoach && dhimantai.legacyCoachOpen && dhimantai.projectOpen"
        }
      ],
      "dhimantai-learning": [
        {
          "id": "dhimantai.learningNavigation",
          "type": "webview",
          "name": "Learning",
          "when": "dhimantai.customDesktop",
          "visibility": "visible"
        }
      ],
      "explorer": [
        {
          "id": "dhimantai.practice",
          "name": "dhimantAI Practice",
          "icon": "media/icon.svg",
          "visibility": "visible"
        },
        {
          "id": "dhimantai.notebookSubmission",
          "name": "dhimantAI Notebook",
          "icon": "media/icon.svg",
          "when": "dhimantai.linkedNotebook",
          "order": 0,
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dhimantai.notebookSubmission",
        "contents": "Run All uses your selected VS Code kernel. Save your notebook on this computer.\n\nNo open dhimantAI page is needed. Code, outputs and run history are not stored on the dhimantAI server.\n\nReturn to your dhimantAI question and attach the file for live feedback when ready. Local output is not a verified assessment."
      }
    ],
    "submenus": [
      {
        "id": "dhimantai.skillingMenu",
        "label": "Skilling"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && tsc -p tsconfig.webview.json && node scripts/bundle-audio.mjs && node scripts/bundle-authoring.mjs",
    "watch": "node scripts/bundle-audio.mjs && node scripts/bundle-authoring.mjs && tsc -w -p .",
    "test": "npm run compile && node scripts/test.mjs",
    "test:diagrams": "npm run compile && node --test out/test/diagramBlocks.test.js && node test/diagramBrowser.cjs",
    "test:signup": "npm run compile && node out/test/integration/runTest.js suiteSignup",
    "test:b2c": "npm run compile && node out/test/integration/runTest.js suiteB2c",
    "test:colab": "npm run compile && node out/test/integration/runTest.js suiteColab",
    "test:copilot": "npm run compile && node out/test/integration/runTest.js suiteCopilotPolicy",
    "vscode:prepublish": "npm run compile && node scripts/bundle-extension.mjs",
    "package": "npx --yes @vscode/vsce@3.2.1 package --no-dependencies --allow-missing-repository --baseContentUrl https://bitbucket.org/optficial/dhimantai/src/codex/question-bank-ux/dhimant-skilling/dhimantai-learning/",
    "test:courses": "npm run compile && node out/test/integration/runTest.js suiteCourseRuntimes",
    "test:vscode": "npm run compile && node out/test/integration/runTest.js suiteExternalProgramming",
    "test:coach-chat": "npm run compile && node out/test/integration/runTest.js suiteNotebookCoachHistory",
    "test:coach-history": "npm run compile && node out/test/integration/runTest.js suiteNotebookCoachHistory",
    "test:projects": "npm run compile && node out/test/integration/runTest.js suiteProjectCoach",
    "test:desktop-ux": "npm run compile && node out/test/integration/runTest.js suiteDesktopUx"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^20.14.0",
    "@types/pdfmake": "0.3.3",
    "@types/vscode": "~1.93.0",
    "@types/ws": "8.18.1",
    "@viz-js/viz": "3.31.0",
    "@vscode/markdown-it-katex": "1.1.2",
    "@vscode/test-electron": "^2.4.1",
    "axe-core": "4.10.3",
    "codemirror": "^6.0.2",
    "esbuild": "0.28.2",
    "jsdom": "^25.0.1",
    "livekit-client": "2.23.0",
    "markdown-it": "14.2.0",
    "mermaid": "12.3.0",
    "pdfjs-dist": "6.5.438",
    "pdfmake": "0.3.15",
    "playwright-core": "1.65.0",
    "typescript": "~5.5.4",
    "ws": "8.18.3"
  },
  "extensionPack": [
    "mads-hartmann.bash-ide-vscode",
    "ms-python.python",
    "ms-toolsai.jupyter",
    "ms-ossdata.vscode-pgsql",
    "ms-python.debugpy",
    "ms-vscode.cpptools",
    "vadimcn.vscode-lldb",
    "rust-lang.rust-analyzer",
    "golang.go",
    "redhat.java",
    "vscjava.vscode-java-debug"
  ]
}
