    {
      "id": "company",
      "title": "1. Find your company\u2019s accounts",
      "doctype": "Company",
      "scenario": "You have joined the back office of {{company}}, which buys Training Widgets, sells them and will assemble them into kits. Before recording anything, find where the company keeps track of who owes whom.",
      "why": "A company owns its chart of accounts, warehouses and transactions. Its default receivable and payable accounts are where ERPNext records money customers owe you and money you owe suppliers. Every invoice later in this course posts to one of them.",
      "steps": [
        {
          "field": "default_currency",
          "value": "INR",
          "text": "Find the default currency."
        },
        {
          "field": "default_receivable_account",
          "value": "Debtors - {{tag}}",
          "text": "On the Accounts tab, find the default receivable account: money customers owe you.",
          "decide": true
        },
        {
          "field": "default_payable_account",
          "value": "Creditors - {{tag}}",
          "text": "Find the default payable account: money you owe suppliers.",
          "decide": true
        }
      ],
      "instructorChapter": "9d757088-f29f-5bbf-8b1f-5060a9166950",
      "expected": {
        "name": "{{company}}",
        "default_currency": "INR",
        "default_receivable_account": "Debtors - {{tag}}",
        "default_payable_account": "Creditors - {{tag}}"
      },
      "explain": "In your own words: what is the difference between the receivable and the payable account, and which one will grow when you bill a customer?",
      "record": "{{company}}",
      "readOnly": true
    },
    {
      "id": "customer",
      "title": "2. Create a customer",
      "doctype": "Customer",
      "scenario": "A local business, Training Customer {{tag}}, in India, wants to buy from you regularly. Set them up once so every later document can point to them.",
      "why": "A customer is reusable master data. Sales orders, deliveries, invoices and payments link to this one record instead of repeating the details.",
      "steps": [
        {
          "field": "customer_name",
          "value": "Training Customer {{tag}}",
          "text": "Enter the customer name."
        },
        {
          "field": "customer_type",
          "value": "Company",
          "text": "This customer is a business.",
          "decide": true
        },
        {
          "field": "customer_group",
          "value": "Commercial",
          "text": "Choose the group for a business customer.",
          "decide": true
        },
        {
          "field": "territory",
          "value": "India",
          "text": "Choose the territory the customer is in.",
          "decide": true
        }
      ],
      "instructorChapter": "cbb43e2b-a03d-5968-886a-459cb0a153ff",
      "expected": {
        "customer_name": "Training Customer {{tag}}",
        "customer_type": "Company",
        "customer_group": "Commercial",
        "territory": "India"
      },
      "explain": "Why does ERPNext keep the customer as its own record instead of typing the name on each invoice? Give one thing that would go wrong otherwise."
    },
